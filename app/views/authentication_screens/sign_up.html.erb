<% content_for :title, "新規登録 - Event Booking" %>

<h1>Event Booking</h1>
<h2>新規登録</h2>
<% if @user.errors.any? %>
  <div role="alert">
    <ul>
      <% @user.errors.each do |error| %>
        <li><%= error.message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: sign_up_path do |form| %>
  <div>
    <%= form.label :student_num, "学籍番号" %>
    <%= form.text_field :student_num, required: true %>
  </div>
  <div>
    <%= form.label :name, "名前" %>
    <%= form.text_field :name, autocomplete: "name", required: true %>
  </div>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, autocomplete: "email", required: true %>
  </div>
  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, autocomplete: "new-password", minlength: 8, required: true %>
  </div>
  <div>
    <%= form.label :password_confirmation, "パスワード確認" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", minlength: 8, required: true %>
  </div>
  <%= form.submit "新規登録" %>
<% end %>

<p><%= link_to "ログインの方はこちら", login_path %></p>
